# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا ترفع .env على Git أبدًا

# عام
APP_NAME=Lumen
ENVIRONMENT=development
DEBUG=false

# قاعدة البيانات — داخل docker-compose استخدم اسم السيرفس "db" كـ host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_backend
DATABASE_URL=postgresql://postgres:change_me@db:5432/ai_backend

# JWT — ضع قيمة عشوائية طويلة وسرّية (مثلاً بأمر: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# رابط الفرونت اند — يُستخدم داخل روابط تأكيد البريد/إعادة تعيين كلمة المرور
FRONTEND_URL=http://localhost:5173
# في الإنتاج: عنوان HTTPS الدقيق لـ /lti/launch؛ اتركه فارغًا إذا لم تفعّل LTI
LTI_TARGET_LINK_URI=

# إيميل — اتركها فاضية والإيميلات تُطبع باللوق بدل الإرسال (وضع تطوير مريح)
# لتفعيل إرسال حقيقي، حط بيانات SMTP الخاصة فيك (Gmail, SendGrid, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# الحماية من Brute Force
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# تشفير أسرار TOTP — ولّد المفتاح بأمر:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# احفظ المفتاح نفسه بشكل دائم في Secret Manager ولا تضعه في Git.
TOTP_ENCRYPTION_KEY=

# رفع الملفات والحماية من البرمجيات الخبيثة
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_USER_STORAGE_MB=100
MAX_USER_FILES=100
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# الاشتراكات والدفع — عبّي القيم من حسابك عند Stripe أو PayPal (Sandbox أولًا للتجربة)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# الأداء — Redis للـ caching، Celery+Redis لإرسال الإيميل بالخلفية
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=60

# عند النشر أضف دومين الفرونت الحقيقي بدل/بجانب localhost
CORS_ORIGINS=["http://localhost:5173"]

# Encrypted offsite backups (optional; enabled only with Compose profile offsite-backup)
# Configure a provider-supported repository URI; examples:
#   RESTIC_REPOSITORY=s3:https://s3.example.com/lumen-backups
#   RESTIC_REPOSITORY=sftp:backup-user@backup.example.com:/srv/lumen
# Store the repository password in backend/secrets/restic-password (never in this file).
RESTIC_REPOSITORY=
RESTIC_BACKUP_TAG=lumen-postgres
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=3
OFFSITE_BACKUP_INTERVAL_SECONDS=3600

# Provider credentials are supplied only when required by the chosen backend.
# For S3-compatible storage, add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# to the real .env file. Never commit those credentials.
