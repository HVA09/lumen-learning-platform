# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا ترفع .env على Git أبدًا

# عام
APP_NAME=Lumen
ENVIRONMENT=development
DEBUG=true

# قاعدة البيانات — داخل docker-compose استخدم اسم السيرفس "db" كـ host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_backend
DATABASE_URL=postgresql://postgres:change_me@db:5432/ai_backend

# JWT — ضع قيمة عشوائية طويلة وسرّية (مثلاً بأمر: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# رابط الفرونت اند — يُستخدم داخل روابط تأكيد البريد/إعادة تعيين كلمة المرور
FRONTEND_URL=http://localhost:5173

# Required in production for LTI login: exact registered target_link_uri values as JSON
LTI_ALLOWED_TARGET_LINK_URIS=[]

# إيميل — اتركها فاضية والإيميلات تُطبع باللوق بدل الإرسال (وضع تطوير مريح)
# لتفعيل إرسال حقيقي، حط بيانات SMTP الخاصة فيك (Gmail, SendGrid, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# الحماية من Brute Force
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# رفع الملفات
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# الاشتراكات والدفع — عبّي القيم من حسابك عند Stripe أو PayPal (Sandbox أولًا للتجربة)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# الأداء — Redis للـ caching، Celery+Redis لإرسال الإيميل بالخلفية
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=60

# عند النشر أضف دومين الفرونت الحقيقي بدل/بجانب localhost
CORS_ORIGINS=["http://localhost:5173"]
