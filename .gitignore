# Environment files and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# JavaScript tooling
**/node_modules/
**/dist/
**/coverage/
**/.vite/
**/.npm/

# Python tooling
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Local databases, logs, uploads, backups
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.log
**/uploads/
**/backups/

# IDE and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Offsite backup credentials (keep only the empty directory marker)
backend/secrets/*
!backend/secrets/.gitkeep
